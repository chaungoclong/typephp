<?php

type ApiResponse<T> = {
    ok: bool,
    data: T,
};

function sendJson<T>(int $status, T $payload): void {
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    echo (string) json_encode($payload);
}

$method: string = 'GET';
$rawMethod: mixed = $_SERVER['REQUEST_METHOD'] ?? 'GET';
if (is_string($rawMethod)) {
    $method = strtoupper($rawMethod);
}

$path: string = '/';
$rawUri: mixed = $_SERVER['REQUEST_URI'] ?? '/';
if (is_string($rawUri)) {
    $parsed: mixed = parse_url($rawUri, PHP_URL_PATH);
    if (is_string($parsed)) {
        $path = $parsed;
    }
}

$pdo = new PDO('sqlite:' . __DIR__ . '/items.db');
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
$pdo->exec('CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)');

if ($path === '/health') {
    $res: ApiResponse<string> = ['ok' => true, 'data' => 'TypePHP Alpine OK'];
    sendJson<ApiResponse<string>>(200, $res);
    return;
}

if ($path === '/items' && $method === 'GET') {
    $stmt: PDOStatement = $pdo->prepare('SELECT id, name FROM items ORDER BY id DESC');
    $stmt->execute([]);
    $rows: dict<int, mixed> = $stmt->fetchAll(PDO::FETCH_ASSOC);
    $res: ApiResponse<dict<int, mixed>> = ['ok' => true, 'data' => $rows];
    sendJson<ApiResponse<dict<int, mixed>>>(200, $res);
    return;
}

if ($path === '/items' && $method === 'POST') {
    $raw: string = (string) file_get_contents('php://input');
    $body: mixed = json_decode($raw, true);
    if (!is_array($body) || !array_key_exists('name', $body)) {
        sendJson<dict<string, mixed>>(400, ['ok' => false, 'error' => 'Field name is required']);
        return;
    }
    $name: mixed = $body['name'];
    if (!is_string($name) || trim($name) === '') {
        sendJson<dict<string, mixed>>(400, ['ok' => false, 'error' => 'Field name must be non-empty string']);
        return;
    }
    $stmt: PDOStatement = $pdo->prepare('INSERT INTO items (name) VALUES (?)');
    $stmt->execute([trim($name)]);
    $id: int = intval($pdo->lastInsertId());
    sendJson<dict<string, mixed>>(201, ['ok' => true, 'data' => ['id' => $id, 'name' => trim($name)]]);
    return;
}

sendJson<dict<string, mixed>>(404, ['ok' => false, 'error' => 'Not found']);
