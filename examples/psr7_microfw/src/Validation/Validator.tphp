<?php

namespace TypePhp\MicroFw\Validation;

import { ValidationResult } from './ValidationResult.tphp';

class Validator {
    private function checkSingleRule(
        string $fieldName,
        mixed $val,
        string $rule,
        bool $isRequired
    ): ?string {
        if ($rule === 'string') {
            if (!is_string($val)) {
                return $fieldName . ' must be a string';
            }
            if ($isRequired && trim($val) === '') {
                return $fieldName . ' cannot be empty';
            }
        } elseif ($rule === 'int') {
            if (!is_int($val)) {
                return $fieldName . ' must be an integer';
            }
        } elseif ($rule === 'bool') {
            if (!is_bool($val)) {
                return $fieldName . ' must be a boolean';
            }
        } elseif (str_starts_with($rule, 'min:')) {
            $minLen: int = intval(substr($rule, 4));
            if (is_string($val)) {
                if (strlen(trim($val)) < $minLen) {
                    return $fieldName . ' must be at least ' . (string) $minLen . ' characters';
                }
            }
        } elseif (str_starts_with($rule, 'max:')) {
            $maxLen: int = intval(substr($rule, 4));
            if (is_string($val)) {
                if (strlen(trim($val)) > $maxLen) {
                    return $fieldName . ' must be at most ' . (string) $maxLen . ' characters';
                }
            }
        }
        return null;
    }

    private function validateField(string $fieldName, mixed $val, string $ruleString): ?string {
        $parts: string[] = explode('|', $ruleString);
        $isRequired: bool = false;
        foreach ($parts as $p) {
            if ($p === 'required') {
                $isRequired = true;
            }
        }
        foreach ($parts as $rule) {
            $err: ?string = $this->checkSingleRule($fieldName, $val, $rule, $isRequired);
            if ($err !== null) {
                return $err;
            }
        }
        return null;
    }

    public function validate(mixed $input, dict<string, string> $rules): ValidationResult {
        $errors: dict<string, string> = [];
        $clean: dict<string, mixed> = [];

        if (!is_array($input)) {
            $errors['_body'] = 'Request body must be a JSON object';
            return new ValidationResult(false, $errors, $clean);
        }

        foreach ($rules as $field => $ruleString) {
            $fieldName: string = (string) $field;
            $hasField: bool = array_key_exists($fieldName, $input);
            $val: mixed = null;
            if ($hasField) {
                $val = $input[$fieldName];
            }

            $parts: string[] = explode('|', $ruleString);
            $isRequired: bool = false;
            foreach ($parts as $p) {
                if ($p === 'required') {
                    $isRequired = true;
                }
            }

            if (!$hasField || $val === null) {
                if ($isRequired) {
                    $errors[$fieldName] = $fieldName . ' is required';
                }
            } else {
                $err: ?string = $this->validateField($fieldName, $val, $ruleString);
                if ($err !== null) {
                    $errors[$fieldName] = $err;
                } else {
                    if (is_string($val)) {
                        $clean[$fieldName] = trim($val);
                    } else {
                        $clean[$fieldName] = $val;
                    }
                }
            }
        }

        $ok: bool = true;
        foreach ($errors as $k => $v) {
            $ok = false;
        }
        return new ValidationResult($ok, $errors, $clean);
    }
}
