<?php

import { ServerRequestInterface } from '../src/Http/Message/ServerRequestInterface.tphp';
import { ResponseInterface } from '../src/Http/Message/ResponseInterface.tphp';
import { ServerRequest } from '../src/Http/Message/ServerRequest.tphp';
import { Response } from '../src/Http/Message/Response.tphp';
import { StringStream } from '../src/Http/Message/StringStream.tphp';
import { Uri } from '../src/Http/Message/Uri.tphp';
import { App, Handler } from '../src/Routing/App.tphp';

use TypePhp\MicroFw\Http\Message\ServerRequestInterface;
use TypePhp\MicroFw\Http\Message\ResponseInterface;
use TypePhp\MicroFw\Http\Message\ServerRequest;
use TypePhp\MicroFw\Http\Message\Response;
use TypePhp\MicroFw\Http\Message\StringStream;
use TypePhp\MicroFw\Http\Message\Uri;
use TypePhp\MicroFw\Routing\App;

function jsonResponse(int $status, mixed $data): ResponseInterface {
    $stream = new StringStream((string) json_encode($data));
    return new Response($status, ['content-type' => 'application/json; charset=utf-8'], $stream);
}

function createServerRequestFromGlobals(): ServerRequestInterface {
    $method: string = 'GET';
    $rawMethod: mixed = $_SERVER['REQUEST_METHOD'] ?? 'GET';
    if (is_string($rawMethod)) {
        $method = strtoupper($rawMethod);
    }
    $rawUri: string = '/';
    $serverUri: mixed = $_SERVER['REQUEST_URI'] ?? '/';
    if (is_string($serverUri)) {
        $rawUri = $serverUri;
    }
    $path: string = '/';
    $parsedPath: mixed = parse_url($rawUri, PHP_URL_PATH);
    if (is_string($parsedPath)) {
        $path = $parsedPath;
    }
    $host: string = 'localhost';
    $rawHost: mixed = $_SERVER['HTTP_HOST'] ?? 'localhost';
    if (is_string($rawHost)) {
        $host = $rawHost;
    }
    $rawBody: string = (string) file_get_contents('php://input');
    $parsed: mixed = null;
    if (trim($rawBody) !== '') {
        $parsed = json_decode($rawBody, true);
    }
    $uri = new Uri('http', $host, $path);
    $stream = new StringStream($rawBody);
    return new ServerRequest($method, $uri, [], $stream, $_GET, $parsed, []);
}

function main(): void {
    $app = new App();

    $app->addMiddleware(fn(ServerRequestInterface $req, Handler $next): ResponseInterface =>
        $next($req->withAttribute('framework', 'TypePHP-PSR7'))
    );

    $app->get('/', fn(ServerRequestInterface $req): ResponseInterface =>
        jsonResponse(200, [
            'ok' => true,
            'framework' => $req->getAttribute('framework'),
            'path' => $req->getUri()->getPath(),
        ])
    );

    $app->get('/hello', fn(ServerRequestInterface $req): ResponseInterface =>
        jsonResponse(200, [
            'ok' => true,
            'message' => 'Hello from PSR-4 Composer Package!',
            'query' => $req->getQueryParams(),
        ])
    );

    $app->post('/echo', fn(ServerRequestInterface $req): ResponseInterface =>
        jsonResponse(200, [
            'ok' => true,
            'received' => $req->getParsedBody(),
        ])
    );

    $request: ServerRequestInterface = createServerRequestFromGlobals();
    $response: ResponseInterface = $app->handle($request);
    $app->emit($response);
}
