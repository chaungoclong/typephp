{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TypePHP",
  "scopeName": "source.typephp",
  "patterns": [
    { "include": "#php-tags" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "php-tags": {
      "patterns": [
        {
          "name": "punctuation.section.embedded.begin.typephp",
          "match": "<\\?php"
        },
        {
          "name": "punctuation.section.embedded.end.typephp",
          "match": "\\?>"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.typephp",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.typephp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.typephp",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.typephp",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.typephp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.typephp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.typephp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.typephp",
              "match": "\\\\['\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.typephp",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.typephp",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.typephp",
          "match": "\\b(if|elseif|else|while|foreach|as|return|echo|import|from|require_once)\\b"
        },
        {
          "name": "keyword.declaration.typephp",
          "match": "\\b(namespace|use|type|interface|implements|extends|enum|case|class|function|fn|const)\\b"
        },
        {
          "name": "storage.modifier.typephp",
          "match": "\\b(public|private|protected)\\b"
        },
        {
          "name": "keyword.operator.typephp",
          "match": "\\b(new|instanceof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.typephp",
          "match": "\\b(int|float|string|bool|void|never|null|mixed|any|array|dict)\\b"
        },
        {
          "name": "entity.name.type.typephp",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.typephp",
          "match": "\\b(true|false|null|__DIR__|PHP_URL_PATH)\\b"
        },
        {
          "name": "constant.other.caps.typephp",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.this.typephp",
          "match": "\\$this\\b"
        },
        {
          "name": "variable.other.superglobal.typephp",
          "match": "\\$(_GET|_POST|_SERVER|_COOKIE|_FILES|_ENV|_REQUEST|_SESSION|GLOBALS)\\b"
        },
        {
          "name": "variable.other.typephp",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.typephp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*(?:<[^>]+>)?\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.typephp",
          "match": "->|=>|::|\\?\\?|===|!==|==|!=|<=|>=|&&|\\|\\|"
        }
      ]
    }
  }
}
