{
  "name": "typephp-language",
  "displayName": "TypePHP Language Support",
  "description": "Syntax highlighting, Hover, Go-to-Definition, Find References, and Diagnostics for TypePHP (.tphp)",
  "version": "0.2.0",
  "publisher": "typephp",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:typephp"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "typephp",
        "aliases": [
          "TypePHP",
          "typephp"
        ],
        "extensions": [
          ".tphp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typephp",
        "scopeName": "source.typephp",
        "path": "./syntaxes/typephp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TypePHP",
      "properties": {
        "typephp.serverPath": {
          "type": "string",
          "default": "tphpc",
          "description": "Path to the tphpc compiler executable (invoked with --lsp)."
        }
      }
    }
  }
}
